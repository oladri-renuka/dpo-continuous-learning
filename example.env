# Redis Configuration (pub/sub + dedup)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400

# MinIO/S3 Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ml-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1

# AWS S3 (for production, if using real AWS)
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# RunPod Configuration (optional, for GPU training)
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_endpoint_id

# Training Configuration
TRAINING_BATCH_SIZE=4
TRAINING_EPOCHS=3
TRAINING_LEARNING_RATE=1e-4
TRAINING_BETA=0.05
TRAINING_MAX_GRAD_NORM=1.0

# Pipeline Configuration
PIPELINE_FEEDBACK_THRESHOLD=500
PIPELINE_RUNPOD_POLL_INTERVAL=30
PIPELINE_MODEL_RELOAD_INTERVAL=60

# Data Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
OUTPUT_DIR=./outputs

# Logging
LOG_LEVEL=INFO
